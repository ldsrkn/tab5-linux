// SPDX-License-Identifier: GPL-2.0-only
/*
 * M5Stack Tab5 overrides, appended to easystick-stamp-p4.dts by build-m1.sh
 * when EASYSTICK_BOARD=tab5.  The SoC side (P4 NRW32, 32 MiB PSRAM, 16 MiB
 * flash, USB-Serial/JTAG console on GPIO24/25) is the same as the Stamp-P4;
 * the boot shim powers the C6 and routes Slot 1 to the Tab5's SDIO pins
 * (CLK 12, CMD 13, DAT0..3 11/10/9/8), so the sdmmc1 node stays as is.
 */

/ {
	model = "M5Stack Tab5";
	compatible = "m5stack,tab5", "espressif,esp32p4";
};

/*
 * GPIO26/27 carry I2S to the audio codec on the Tab5, not a USB connector,
 * and the boot shim leaves the FS OTG PHY off.  Without a UDC the userland
 * skips the USB mass-storage drive.
 */
&usb_otg11 {
	status = "disabled";
};

/*
 * ST7123 720x1280 panel on the P4 MIPI-DSI host, two lanes (WHY2025's DSI
 * glue, kernel patches 0003/0073/0074; panel driver 0075).  The glue enables
 * the DSI clocks and LDO3 (VDD_MIPI_DPHY 2.5 V) itself.  The boot shim
 * releases LCD_RST (P4 of the 0x43 expander) and turns the backlight
 * (GPIO22) on, since Linux has no driver for either.
 */
/ {
	/* The DW-MIPI-DSI core needs a "pclk"; the APB clock is already on. */
	dsi_pclk: dsi-pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
		clock-output-names = "dsi-pclk";
	};

	reserved-memory {
		/*
		 * Scan-out buffer (720x1280 RGB565, 1.8 MB, an order-9
		 * allocation) and the GDMA descriptor page, kept out of the
		 * buddy allocator, which rarely has 2 MB free in one piece
		 * next to the NOMMU user pools.  Ends where the low user pool
		 * (0x495af000) starts.
		 */
		display_pool: display-pool@4939f000 {
			compatible = "shared-dma-pool";
			reg = <0x4939f000 0x00210000>;
			no-map;
		};
	};

	chosen {
		/*
		 * Landscape console with the keyboard below the screen: fbcon
		 * rotates the 720x1280 panel, Terminus 16x32 gives 80x22.
		 * console=ttyGS1 stays last, so /dev/console is still USB-C.
		 */
		bootargs = "earlycon=esp32p4usbjtag,mmio32,0x500d2000 console=tty0 console=ttyGS1,115200n8 loglevel=4 root=/dev/mtdblock0 rootfstype=squashfs ro init=/sbin/init maxcpus=1 fbcon=rotate:1 fbcon=font:TER16x32";
	};
};

&soc {
	dsi: dsi@500a0000 {
		compatible = "espressif,esp32p4-mipi-dsi";
		reg = <0x500a0000 0x0800>,	/* DW-MIPI-DSI host */
		      <0x500a0800 0x0100>;	/* Espressif bridge */
		reg-names = "host", "bridge";
		clocks = <&dsi_pclk>;
		clock-names = "pclk";
		/* The Tab5 panel is scanned in its native orientation. */
		espressif,blit-direct;
		/*
		 * The ROM cache ops make devices non-coherent by default, and
		 * NOMMU has no uncached remap, so dma_alloc_coherent() fails
		 * ("coherent DMA allocations not supported").  The glue
		 * flushes its scan-out buffer and GDMA descriptor itself.
		 */
		dma-coherent;
		memory-region = <&display_pool>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
				dsi_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};
		};

		panel@0 {
			compatible = "sitronix,st7123";
			reg = <0>;

			port {
				panel_in: endpoint {
					remote-endpoint = <&dsi_out>;
				};
			};
		};
	};
};

#include <dt-bindings/gpio/gpio.h>

/*
 * Tab5 Keyboard (A164) on Ext.Port1: SDA GPIO0, SCL GPIO1, I2C 0x6d
 * (kernel patch 0076).  Bank 0 of the P4 GPIO controller (WHY2025's 0002
 * driver; it shares the MMIO page with gpio1) carries both lines; the bus is
 * bit-banged like WHY2025's keypad bus.  The keyboard's INT (GPIO50) is not
 * used: the driver polls.
 */
&soc {
	gpio0: gpio@500e0000 {
		compatible = "espressif,esp32p4-gpio";
		reg = <0x500e0000 0x1000>;
		espressif,bank-id = <0>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";

		/*
		 * The backlight enable (GPIO22) must be a line this driver owns:
		 * on every direction change (the bit-banged I2C toggles SDA each
		 * poll) it writes ENABLE_W1TC with every line it does not drive
		 * as an output, which turned off the output the boot shim set.
		 */
		lcd-backlight-hog {
			gpio-hog;
			gpios = <22 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd-backlight";
		};
	};
};

/ {
	i2c_ext: i2c-ext {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio0 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		i2c-gpio,delay-us = <5>;	/* about 100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;

		keyboard@6d {
			compatible = "m5stack,tab5-keyboard";
			reg = <0x6d>;
		};
	};
};

/*
 * Tab5 microSD slot, driven in SPI mode.  The slot is SDMMC Slot 0 on the
 * dedicated pads GPIO39..44, but the P4 has one SDMMC controller whose
 * Slot 1 is taken by the C6 and the local dw_mmc driver is single-slot, so
 * the card is bit-banged instead (M5's documented SPI-mode mapping):
 *
 *   GPIO43 CLK -> SCK    GPIO44 CMD -> MOSI    GPIO39 DAT0 -> MISO
 *   GPIO42 DAT3 -> CS    (GPIO40/41, DAT1/DAT2, stay idle)
 *
 * GPIO32.. live in bank 1, whose line numbers start at 0: line = GPIO - 32.
 * The boot shim switches the slot's I/O rail (LDO4, 3.3 V) on; the GPIO
 * driver moves the pads to the GPIO function when a line is requested.
 * No card-detect line is wired, so mmc_spi polls.
 */
/ {
	spi_sd: spi-sd {
		compatible = "spi-gpio";
		sck-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		miso-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		num-chipselects = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		sdcard@0 {
			compatible = "mmc-spi-slot";
			reg = <0>;
			spi-max-frequency = <4000000>;
			voltage-ranges = <3200 3400>;
		};
	};
};

/*
 * Tab5 RS485 (SIT3088) on UART1: TX GPIO20, RX GPIO21, DIR GPIO34 (M5Stack
 * pin table).  The boot shim clocks UART1 from XTAL / 4 (10 MHz, so 9600
 * baud fits the 12-bit divider), routes the three pads through the GPIO
 * matrix and leaves the UART core to Linux (patch 0079).  DIR is the UART's
 * RTS output; "linux,rs485-enabled-at-boot-time" puts the port in hardware
 * half-duplex mode, where RTS rises only while a character is being sent.
 * It appears as /dev/ttyS2 (serial0 is UART0, serial1 the USB serial/JTAG).
 * CLIC slot 25 / INTMTX source 32 (ETS_UART1_INTR_SOURCE).
 */
/ {
	aliases {
		serial2 = &uart1;
		serial3 = &uart2;
	};

	uart1_sclk: uart1-sclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <10000000>;
		clock-output-names = "uart1-sclk";
	};

	uart2_sclk: uart2-sclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <10000000>;
		clock-output-names = "uart2-sclk";
	};
};

&soc {
	uart1: serial@500cb000 {
		compatible = "esp,esp32p4-uart";
		reg = <0x500cb000 0x1000>;
		interrupts-extended = <&clic0 25 32 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&uart1_sclk>;
		linux,rs485-enabled-at-boot-time;
		status = "okay";
	};

	/* Grove UART, see the Grove comment below.  CLIC slot 26 / source 33. */
	uart2: serial@500cc000 {
		compatible = "esp,esp32p4-uart";
		reg = <0x500cc000 0x1000>;
		interrupts-extended = <&clic0 26 33 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&uart2_sclk>;
		status = "okay";
	};
};

/*
 * Tab5 Grove port (HY2.0-4P, PORT.A): yellow G53, white G54 (case label).
 * The pads carry either UART2 (/dev/ttyS3) or this bit-banged I2C bus, never
 * both.  The M5Stack PORT.A colour convention gives yellow = SDA, white =
 * SCL for I2C and yellow = host TX, white = host RX for UART; the case only
 * labels the GPIO numbers, so both assignments are still to be confirmed
 * with a real Unit.  The boot shim only clocks UART2.  grove-mode (run by
 * S42grove, setting kept in /boot/grove.txt) writes the GPIO matrix and
 * binds or unbinds this i2c-gpio device, so switching needs no rebuild.
 * Default is UART (Unit DMX).  G53/G54 are GPIO53/54, i.e. bank 1 lines
 * 21 and 22.
 */
/ {
	i2c_grove: i2c-grove {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio1 21 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio1 22 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		i2c-gpio,delay-us = <5>;	/* about 100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
