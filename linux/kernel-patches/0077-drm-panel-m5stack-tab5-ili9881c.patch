+static int tab5_ili9881c_prepare(struct drm_panel *panel)
+{
+	struct tab5_ili9881c *ctx = panel_to_tab5_ili9881c(panel);
+
+	if (ctx->reset) {
+		gpiod_set_value_cansleep(ctx->reset, 1);
+		usleep_range(10000, 11000);
+		gpiod_set_value_cansleep(ctx->reset, 0);
+		msleep(120);
+	}
+	return 0;
+}
+
+/*
+ * The DSI glue keeps the host in command mode until the panel is set up and
+ * starts video afterwards, so the whole table goes out from .enable (the same
+ * arrangement as the Tab5's ST7123 driver).
+ */
+static int tab5_ili9881c_enable(struct drm_panel *panel)
+{
+	struct tab5_ili9881c *ctx = panel_to_tab5_ili9881c(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	tab5_ili9881c_init_lanes(&dsi_ctx);
+	tab5_ili9881c_init_sleep_out(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	tab5_ili9881c_init_page3(&dsi_ctx);
+	tab5_ili9881c_init_power_gamma(&dsi_ctx);
+	/* M5GFX writes MADCTL (RGB order) and COLMOD (RGB565) after the lists. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_PIXEL_FORMAT, 0x55);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	if (dsi_ctx.accum_err)
+		dev_err(&ctx->dsi->dev, "panel init failed: %d\n",
+			dsi_ctx.accum_err);
+	return dsi_ctx.accum_err;
+}
+
+static int tab5_ili9881c_disable(struct drm_panel *panel)
+{
+	struct tab5_ili9881c *ctx = panel_to_tab5_ili9881c(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode tab5_ili9881c_mode = {
+	.clock		= 80000,
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 40,
+	.hsync_end	= 720 + 40 + 40,
+	.htotal		= 720 + 40 + 40 + 140,
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 20,
+	.vsync_end	= 1280 + 20 + 4,
+	.vtotal		= 1280 + 20 + 4 + 20,
+	.flags		= DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	.width_mm	= 62,
+	.height_mm	= 110,
+};
+
+static int tab5_ili9881c_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct tab5_ili9881c *ctx = panel_to_tab5_ili9881c(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &tab5_ili9881c_mode);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+	return 1;
+}
+
+static enum drm_panel_orientation
+tab5_ili9881c_get_orientation(struct drm_panel *panel)
+{
+	return panel_to_tab5_ili9881c(panel)->orientation;
+}
+
+static const struct drm_panel_funcs tab5_ili9881c_funcs = {
+	.prepare	= tab5_ili9881c_prepare,
+	.enable		= tab5_ili9881c_enable,
+	.disable	= tab5_ili9881c_disable,
+	.get_modes	= tab5_ili9881c_get_modes,
+	.get_orientation = tab5_ili9881c_get_orientation,
+};
+
+static int tab5_ili9881c_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct tab5_ili9881c *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct tab5_ili9881c, panel,
+				   &tab5_ili9881c_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "cannot get reset gpio\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "cannot read orientation\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB565;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "mipi_dsi_attach failed\n");
+	}
+	return 0;
+}
+
+static void tab5_ili9881c_remove(struct mipi_dsi_device *dsi)
+{
+	struct tab5_ili9881c *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id tab5_ili9881c_of_match[] = {
+	{ .compatible = "m5stack,tab5-ili9881c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tab5_ili9881c_of_match);
+
+static struct mipi_dsi_driver tab5_ili9881c_driver = {
+	.probe	= tab5_ili9881c_probe,
+	.remove	= tab5_ili9881c_remove,
+	.driver = {
+		.name = "panel-m5stack-tab5-ili9881c",
+		.of_match_table = tab5_ili9881c_of_match,
+	},
+};
+module_mipi_dsi_driver(tab5_ili9881c_driver);
+
+MODULE_DESCRIPTION("M5Stack Tab5 ILI9881C MIPI-DSI panel driver");
+MODULE_LICENSE("GPL");
