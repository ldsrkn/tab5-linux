+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ILI9881C 720x1280 MIPI-DSI panel as fitted to early M5Stack Tab5 units
+ * (GT911 touch controller, panel ID read as 98 81 5C on page 1).
+ *
+ * The init table is the one M5Stack's own M5GFX carries for the Tab5
+ * (lgfx/v1/platforms/esp32p4/Panel_ILI9881C.hpp, getInitParams() lists
+ * 0..3), converted mechanically and sent in the same order:
+ *
+ *   page 1: PAD_CONTROL (0xb7) = 2 lanes
+ *   page 0: sleep out, 120 ms
+ *   page 3: GIP / panel-interface registers
+ *   page 4, page 1: power, gamma P / N
+ *   page 0: 0x35, 0xfe (sent without parameters, as M5GFX does), display on
+ *   then MADCTL = 0x00 and COLMOD = 0x55 (RGB565), as M5GFX's
+ *   Panel_DSI::init_panel() does in command mode.
+ *
+ * Timings are M5GFX's too (80 MHz, 720x1280, hbp/hsw/hfp = 140/40/40,
+ * vbp/vsw/vfp = 20/4/20).  The ESP32-P4 DSI glue runs the lane at a fixed
+ * 1000 Mbps (M5GFX uses 1040 Mbps for the same panel).
+ *
+ * The panel reset is LCD_RST on an I2C IO expander that Linux does not
+ * drive; the boot shim pulses it.  An optional reset-gpios is honoured for
+ * boards that wire it to a GPIO.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct tab5_ili9881c {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct tab5_ili9881c *panel_to_tab5_ili9881c(struct drm_panel *panel)
+{
+	return container_of(panel, struct tab5_ili9881c, panel);
+}
+
+/* M5GFX list0: select page 1, tell the panel it has two DSI lanes. */
+static void tab5_ili9881c_init_lanes(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x98, 0x81, 0x01);
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xb7, 0x03);
+}
+
+/* M5GFX list1: back to page 0, sleep out (the caller waits 120 ms). */
+static void tab5_ili9881c_init_sleep_out(struct mipi_dsi_multi_context *ctx)
+{
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xff, 0x98, 0x81, 0x00);
+	mipi_dsi_dcs_exit_sleep_mode_multi(ctx);
+}
+
